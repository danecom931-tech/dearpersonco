{%- comment -%}
  DearPersonCo — "What to expect" timeline section.
  Add via Theme editor → Add section → "DP Timeline".
  Each timeline stage is a block; bullets are entered one per line.
{%- endcomment -%}

{%- if section.settings.use_poppins -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #dp-timeline-{{ section.id }} {
    --dpt-bg-start: {{ section.settings.bg_start }};
    --dpt-bg-end: {{ section.settings.bg_end }};
    --dpt-text: {{ section.settings.text_color }};
    --dpt-accent: {{ section.settings.accent_color }};
    --dpt-pill-bg: {{ section.settings.pill_bg }};
    --dpt-pill-text: {{ section.settings.pill_text }};
    --dpt-line: {{ section.settings.line_color }};
    position: relative;
    background: linear-gradient(135deg, var(--dpt-bg-start) 0%, var(--dpt-bg-end) 100%);
    color: var(--dpt-text);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    {%- if section.settings.use_poppins %}
    font-family: 'Poppins', sans-serif;
    {%- endif %}
  }
  {%- if section.settings.show_stripes %}
  #dp-timeline-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      -60deg,
      rgba(255, 255, 255, 0.06) 0 1px,
      transparent 1px 28px
    );
    pointer-events: none;
  }
  {%- endif %}
  #dp-timeline-{{ section.id }} .dpt__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }
  #dp-timeline-{{ section.id }} .dpt__heading {
    color: var(--dpt-text);
    font-family: inherit;
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    text-align: {{ section.settings.heading_align }};
  }
  #dp-timeline-{{ section.id }} .dpt__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 880px;
  }
  #dp-timeline-{{ section.id }} .dpt__stage {
    position: relative;
    padding: 0 0 44px 50px;
  }
  #dp-timeline-{{ section.id }} .dpt__stage:last-child {
    padding-bottom: 0;
  }
  /* Vertical connector line */
  #dp-timeline-{{ section.id }} .dpt__stage::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 14px;
    bottom: -14px;
    width: 2px;
    background: var(--dpt-line);
  }
  #dp-timeline-{{ section.id }} .dpt__stage:last-child::before {
    bottom: 0;
  }
  /* Square marker */
  #dp-timeline-{{ section.id }} .dpt__marker {
    position: absolute;
    left: 0;
    top: 4px;
    width: 24px;
    height: 24px;
    box-sizing: border-box;
    border: 3px solid var(--dpt-pill-bg);
    border-radius: 3px;
    background: var(--dpt-bg-start);
    z-index: 1;
  }
  #dp-timeline-{{ section.id }} .dpt__pill {
    display: inline-block;
    background: var(--dpt-pill-bg);
    color: var(--dpt-pill-text);
    border-radius: 4px;
    padding: 11px 18px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.3;
    margin-bottom: 14px;
  }
  #dp-timeline-{{ section.id }} .dpt__pill-label {
    color: var(--dpt-accent);
  }
  #dp-timeline-{{ section.id }} .dpt__desc {
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    margin: 0 0 12px;
    color: var(--dpt-text);
    opacity: 0.92;
  }
  #dp-timeline-{{ section.id }} .dpt__desc p { margin: 0; }
  #dp-timeline-{{ section.id }} .dpt__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #dp-timeline-{{ section.id }} .dpt__bullet {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.5;
    margin-top: 12px;
  }
  #dp-timeline-{{ section.id }} .dpt__check {
    color: var(--dpt-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    #dp-timeline-{{ section.id }} .dpt__heading { margin-bottom: 24px; }
    #dp-timeline-{{ section.id }} .dpt__stage { padding: 0 0 32px 38px; }
    #dp-timeline-{{ section.id }} .dpt__marker { width: 20px; height: 20px; }
    #dp-timeline-{{ section.id }} .dpt__stage::before { left: 9px; }
    #dp-timeline-{{ section.id }} .dpt__pill { font-size: 14px; padding: 9px 14px; }
    #dp-timeline-{{ section.id }} .dpt__desc,
    #dp-timeline-{{ section.id }} .dpt__bullet { font-size: 15px; letter-spacing: 0.02em; }
    #dp-timeline-{{ section.id }} .dpt__bullet { gap: 10px; }
  }
</style>

<section id="dp-timeline-{{ section.id }}" class="dpt">
  <div class="dpt__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="dpt__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ol class="dpt__list">
      {%- for block in section.blocks -%}
        <li class="dpt__stage" {{ block.shopify_attributes }}>
          <span class="dpt__marker" aria-hidden="true"></span>

          {%- if block.settings.label != blank or block.settings.title != blank -%}
            <div class="dpt__pill">
              {%- if block.settings.label != blank -%}
                <span class="dpt__pill-label">{{ block.settings.label }}:</span>
              {%- endif %}
              {{ block.settings.title }}
            </div>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <div class="dpt__desc">{{ block.settings.description }}</div>
          {%- endif -%}

          {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
          {%- if block.settings.bullets != blank -%}
            <ul class="dpt__bullets">
              {%- for line in bullet_lines -%}
                {%- assign bullet = line | strip -%}
                {%- if bullet != blank -%}
                  <li class="dpt__bullet">
                    <span class="dpt__check" aria-hidden="true">✓</span>
                    <span>{{ bullet }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "DP Timeline",
  "tag": "div",
  "class": "shopify-section--dp-timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What to expect as support builds over time"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "use_poppins",
      "label": "Use Poppins font",
      "info": "Uncheck to use your theme's font instead.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_start",
      "label": "Background gradient start",
      "default": "#4f3a20"
    },
    {
      "type": "color",
      "id": "bg_end",
      "label": "Background gradient end",
      "default": "#7d5a28"
    },
    {
      "type": "checkbox",
      "id": "show_stripes",
      "label": "Show diagonal stripe pattern",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (label & checkmarks)",
      "default": "#c9a24a"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Label pill & marker",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_text",
      "label": "Label pill text",
      "default": "#4a3418"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Timeline line",
      "default": "#a88c66"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Timeline stage",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (accent color)",
          "info": "A colon is added automatically.",
          "default": "Week 1–2"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Easy Start"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>One capsule with breakfast. The enzyme begins circulating and going to work on fibrin.</p>"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Checklist items",
          "info": "One item per line.",
          "default": "One capsule a day, with food\nNo loading phase, no timing rules"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DP Timeline",
      "blocks": [
        {
          "type": "stage",
          "settings": {
            "label": "Week 1–2",
            "title": "Easy Start",
            "description": "<p>One capsule with breakfast. The enzyme begins circulating and going to work on fibrin.</p>",
            "bullets": "One capsule a day, with food\nNo loading phase, no timing rules"
          }
        },
        {
          "type": "stage",
          "settings": {
            "label": "Week 3–5",
            "title": "Circulation Shifts",
            "description": "<p>The first thing most people notice has nothing to do with a lab report.</p>",
            "bullets": "Warmer hands and feet\nLess heaviness in the legs"
          }
        },
        {
          "type": "stage",
          "settings": {
            "label": "Week 6–12",
            "title": "The Numbers Move",
            "description": "<p>Ongoing support for healthy cholesterol levels starts showing up on paper.*</p>",
            "bullets": "Support for your next blood panel*\nStairs and hills feel easier"
          }
        },
        {
          "type": "stage",
          "settings": {
            "label": "Month 3–12",
            "title": "The Long Game",
            "description": "<p>The research that measured plaque reduction ran a full year. This is the stretch that mattered.</p>",
            "bullets": "Continued fibrinolytic support*\nA routine built on the mechanism, not the symptom"
          }
        }
      ]
    }
  ]
}
{% endschema %}
