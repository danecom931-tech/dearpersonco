{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BUY BUTTONS
----------------------------------------------------------------------------------------------------------------------

This component is used to show the buy buttons

********************************************
Supported variables
********************************************

* product: the product from which to show the buttons
* show_payment_button: if we show or not the dynamic checkout button
* show_gift_card_recipient: for gift card products, an optional message/email to be sent to the recipient
* button_size: the size of the button (default to xl if none is passed)
* atc_button_background: the background of the ATC button
* atc_button_text_color: the text color of the ATC button
* payment_button_background: the custom dynamic checkout button background
* payment_button_text_color: the custom dynamic checkout button text color
* form_id: if specified, define the form ID linked to this input
{%- endcomment -%}

{%- assign variant_picker_block = section.blocks | where: 'type', 'variant_picker' | first -%}

{%- assign recipient_feature_active = false -%}

{%- if product.gift_card? and show_gift_card_recipient -%}
  {%- assign recipient_feature_active = true -%}
  {%- assign show_payment_button = false -%}
{%- endif -%}

{%- form 'product', product, is: 'product-form', id: form_id -%}
  <input type="hidden" {% if variant_picker_block != blank %}disabled{% endif %} name="id" value="{{ product.selected_or_first_available_variant.id }}">

  {%- assign button_disabled = false -%}
  {%- assign button_size = button_size | default: 'xl' -%}

  {%- comment -%}
    Comfrt-style Add to Cart: variant price shown next to the label, with the
    stock status on a second line underneath. To change the wording, edit
    `atc_in_stock_text` below. NOTE: this price is the product/variant price,
    not a bundle-app total.
  {%- endcomment -%}
  {%- assign atc_in_stock_text = 'In-Stock: Ready to Ship' -%}
  {%- assign atc_variant = product.selected_or_first_available_variant -%}
  {%- assign atc_price = '' -%}
  {%- if atc_variant != nil -%}
    {%- assign atc_price = atc_variant.price | money -%}
  {%- endif -%}

  {%- if product.selected_or_first_available_variant == nil -%}
    {%- capture button_content -%}{{ 'product.general.unavailable_button' | t }}{%- endcapture -%}
    {%- assign button_disabled = true -%}
  {%- elsif product.selected_or_first_available_variant.available -%}
    {%- if product.template_suffix contains 'pre-order' -%}
      {%- capture button_content -%}<span class="atc-multiline"><span class="atc-multiline__main">{{ 'product.general.pre_order_button' | t }} - <span class="atc-multiline__price" data-base-price="{{ atc_price | strip_html | escape }}">{{ atc_price }}</span></span></span>{%- endcapture -%}
    {%- else -%}
      {%- capture button_content -%}<span class="atc-multiline"><span class="atc-multiline__main">{{ 'product.general.add_to_cart_button' | t }} - <span class="atc-multiline__price" data-base-price="{{ atc_price | strip_html | escape }}">{{ atc_price }}</span></span><span class="atc-multiline__status">{{ atc_in_stock_text }}</span></span>{%- endcapture -%}
    {%- endif -%}
  {%- else -%}
    {%- capture button_content -%}{{ 'product.general.sold_out_button' | t }}{%- endcapture -%}
    {%- assign button_disabled = true -%}
  {%- endif -%}

  <style>
    /* Comfrt-style two-line ATC button (label + price on top, stock status below). */
    .buy-buttons .button:has(.atc-multiline) {
      height: auto;
      padding-block: 0.9rem;
      line-height: 1.2;
    }

    .atc-multiline {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .atc-multiline__status {
      font-size: 0.75em;
      font-weight: 400;
      opacity: 0.85;
    }
  </style>

  <div class="v-stack gap-4">
    {%- if recipient_feature_active -%}
      <gift-card-recipient class="gift-card-recipient v-stack gap-3">
        {%- assign checkbox_label = 'gift_card.recipient.checkbox' | t -%}
        {%- render 'checkbox', label: checkbox_label, name: 'properties[__shopify_send_gift_card_to_recipient]' -%}

        <div class="gift-card-recipient__fields" hidden>
          <div class="fieldset">
            {%- liquid
              assign recipient_email_label = 'gift_card.recipient.email_label' | t
              render 'input', type: 'email', label: recipient_email_label, name: 'properties[Recipient email]', value: form.email, required: true, maxlength: 138

              assign recipient_name_label = 'gift_card.recipient.name_label' | t
              render 'input', label: recipient_name_label, name: 'properties[Recipient name]', value: form.name

              assign send_on_label = 'gift_card.recipient.send_on_label' | t
              render 'input', type: 'date', label: send_on_label, name: 'properties[Send on]', value: form.send_on, pattern: '\d{4}-\d{2}-\d{2}'
              render 'input', type: 'hidden', name: 'properties[__shopify_offset]'

              assign message_label = 'gift_card.recipient.message_label' | t
              render 'input', label: message_label, name: 'properties[Message]', value: form.message, multiline: 3, maxlength: 200, show_max_characters_count: true
            -%}
          </div>
        </div>
      </gift-card-recipient>
    {%- endif -%}

    <buy-buttons class="buy-buttons {% if show_payment_button %}buy-buttons--multiple{% endif %}" template="{{ product.template_suffix | escape }}" form="{{ form_id }}">
      {%- render 'button', content: button_content, type: 'submit', size: button_size, disabled: button_disabled, secondary: show_payment_button, subdued: button_disabled, background: atc_button_background, text_color: atc_button_text_color -%}

      {%- if show_payment_button -%}
        {{- form | payment_button -}}

        <style>
          #{{ form_id }} .shopify-payment-button {
            {%- unless product.selected_or_first_available_variant.available -%}
              display: none;
            {%- endunless -%}

            {%- if payment_button_background != blank and payment_button_background != 'rgba(0,0,0,0)' -%}
              --button-background: {{ payment_button_background.rgb }};
            {%- endif -%}

            {%- if payment_button_text_color != blank and payment_button_text_color != 'rgba(0,0,0,0)' -%}
              --button-text-color: {{ payment_button_text_color.rgb }};
            {%- endif -%}
          }
        </style>
      {%- endif -%}
    </buy-buttons>
  </div>

  {%- comment -%}
    Kaching Bundles bridge: mirror the selected bundle's price onto the ATC
    button's `.atc-multiline__price`. Harmless if Kaching isn't on the page —
    it simply leaves the variant price rendered above. Reads Kaching's own DOM
    (`.kaching-bundles__bars` / `--selected` / `.kaching-bundles__bar-price`).
  {%- endcomment -%}
  <script>
    (function () {
      if (window.__dpcKachingAtcBridge) return;
      window.__dpcKachingAtcBridge = true;

      var PRICE_SEL = '.kaching-bundles__bar-price,[data-a11y-label="system.price"]';
      // Kaching nests the struck-through full price inside the price node; strip it
      // so the button shows only the sale price (Comfrt-style, single price).
      var FULL_PRICE_SEL = '.kaching-bundles__bar-full-price,[data-a11y-label="system.original_price"]';

      function norm(s) { return (s || '').replace(/\s+/g, ' ').trim(); }
      // Parse a money string to a number (USD-style: comma = thousands). Lets
      // "$35" and "$35.00" compare equal.
      function amt(s) {
        var m = norm(s).match(/[\d.,]+/);
        return m ? parseFloat(m[0].replace(/,/g, '')) : NaN;
      }
      function bars() {
        return document.querySelector('.kaching-bundles__bars') || document.querySelector('kaching-bundle');
      }
      function barList() {
        var b = bars();
        return b ? Array.prototype.slice.call(b.querySelectorAll('.kaching-bundles__bar')) : [];
      }
      function selectedBar() {
        var b = bars(); if (!b) return null;
        var sel = b.querySelector('.kaching-bundles__bar--selected');
        if (sel) return sel;
        var radio = b.querySelector('input[type="radio"]:checked');
        if (radio) return radio.closest('.kaching-bundles__bar') || b;
        return b.querySelector('.kaching-bundles__bar') || b;
      }
      function selectedIndex() { return barList().indexOf(selectedBar()); }
      function selectedPrice() {
        var s = selectedBar() || bars(); if (!s) return '';
        var pe = s.querySelector(PRICE_SEL);
        if (!pe) return '';
        var clone = pe.cloneNode(true);
        var full = clone.querySelectorAll(FULL_PRICE_SEL);
        for (var i = 0; i < full.length; i++) { full[i].parentNode.removeChild(full[i]); }
        return norm(clone.textContent);
      }
      function priceTargets() { return document.querySelectorAll('.atc-multiline__price'); }
      function baseAmt() {
        var t = priceTargets()[0];
        return t ? amt(t.getAttribute('data-base-price')) : NaN;
      }
      function paint(txt) {
        var ts = priceTargets();
        for (var i = 0; i < ts.length; i++) { ts[i].textContent = txt; }
      }
      // Paint the selected price, but skip Kaching's transient 1-pc value.
      // On a bundle/variant change Kaching holds the 1-pc base price for ~1-2s
      // while it recalculates; that value equals the base variant price. So while
      // any non-first bundle is selected, ignore a reading that matches the base
      // price and wait for the settled bundle total. Returns true once painted.
      function trySync() {
        var price = selectedPrice(); if (!price) return false;
        var base = baseAmt();
        if (selectedIndex() !== 0 && !isNaN(base) && Math.abs(amt(price) - base) < 0.005) return false;
        paint(price);
        return true;
      }
      // Poll for a window after each change so the settled price gets painted
      // once Kaching finishes recalculating.
      var pollIv = null;
      function pollWindow(ms) {
        if (pollIv) clearInterval(pollIv);
        var start = Date.now();
        pollIv = setInterval(function () {
          trySync();
          if (Date.now() - start > ms) { clearInterval(pollIv); pollIv = null; }
        }, 120);
      }
      function init() {
        var b = bars(); if (!b) return false;
        trySync();
        document.addEventListener('change', function (e) {
          if (e.target && e.target.name && e.target.name.indexOf('kaching-bundles-deal') === 0) pollWindow(3000);
        });
        b.addEventListener('click', function () { pollWindow(3000); });
        new MutationObserver(function () { pollWindow(2000); }).observe(b, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['class'] });
        return true;
      }
      function boot() {
        if (init()) return;
        var n = 0, iv = setInterval(function () { if (init() || ++n > 40) clearInterval(iv); }, 400);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    })();
  </script>
{%- endform -%}
